rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Anyone can view the images (so customers can see the menu photos)
    // ONLY logged in admins can upload or delete photos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true;
    }
  }
}
